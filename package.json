{
  "name": "frontend_mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "dependencies": {
    "@expo/ui": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-kakao/core": "^2.4.6",
    "@react-native-kakao/user": "^2.4.6",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.11",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-glass-effect": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "verify:auth-session": "tsc -p tsconfig.auth-verification.json && node .auth-verification/scripts/verify-auth-session.js",
    "verify:ios-release": "node scripts/verify-ios-release.mjs",
    "verify:group-preferences": "tsc -p tsconfig.group-verification.json && node .group-verification/scripts/verify-group-preferences.js",
    "verify:preference-compatibility": "tsc -p tsconfig.preference-verification.json && node .preference-verification/scripts/verify-preference-compatibility.js",
    "verify:preference-submission": "tsc -p tsconfig.preference-verification.json && node .preference-verification/scripts/verify-preference-submission.js",
    "verify:trip-flow": "tsc -p tsconfig.trip-flow-verification.json && node .trip-flow-verification/scripts/verify-trip-flow.js",
    "verify:api-trip-contract": "node scripts/run-api-trip-contract-verification.mjs",
    "verify:place-flow": "tsc -p tsconfig.place-flow-verification.json && node .place-flow-verification/scripts/verify-place-flow.js",
    "verify:workspace-editor": "tsc -p tsconfig.workspace-verification.json && node .workspace-verification/scripts/verify-workspace-editor.js",
    "verify:workspace-schedule-api": "tsc -p tsconfig.schedule-api-verification.json && node .schedule-api-verification/scripts/verify-workspace-schedule-contract.js",
    "verify:workspace-planning-dates-api": "tsc -p tsconfig.workspace-planning-dates-verification.json && node .workspace-planning-dates-verification/scripts/verify-workspace-planning-trip-dates-api.js",
    "verify:workspace-reservation-api": "tsc -p tsconfig.workspace-reservation-verification.json && node ../.codex-verification/workspace-reservation/scripts/verify-workspace-reservation-api.js",
    "verify:trip-documents": "tsc -p tsconfig.trip-documents-verification.json && node .trip-documents-verification/scripts/verify-trip-documents.js",
    "verify:trip-todos": "tsc -p tsconfig.trip-todos-verification.json && node .trip-todos-verification/scripts/verify-trip-todos.js",
    "verify:duri-analysis": "tsc -p tsconfig.duri-verification.json && node .duri-verification/scripts/verify-duri-analysis.js",
    "verify:preference-auto-fill": "tsc -p tsconfig.preference-auto-fill-verification.json && node .preference-auto-fill-verification/scripts/verify-preference-auto-fill.js",
    "verify:room-preferences": "tsc -p tsconfig.room-preferences-verification.json && node .room-preferences-verification/scripts/verify-room-preferences.js",
    "seed:busan-api-room": "node scripts/seed-busan-api-room.mjs",
    "seed:busan-api-room:stress": "node scripts/seed-busan-api-room.mjs --stress",
    "verify:busan-api-fixture": "node scripts/verify-busan-api-fixture.mjs",
    "verify:challenge-style-model": "node scripts/verify-challenge-style-model.mjs",
    "verify:challenge-style-random-forest": "node scripts/verify-challenge-style-random-forest.mjs",
    "verify:challenge-style-clusterers": "node scripts/verify-challenge-style-clusterers.mjs",
    "validate:state": "tsc -p tsconfig.state-integrity-verification.json && node .state-integrity-verification/scripts/validate-state.js",
    "verify:state-integrity": "tsc -p tsconfig.state-integrity-verification.json && node .state-integrity-verification/scripts/verify-state-integrity.js",
    "build": "expo export --platform all"
  },
  "private": true
}
