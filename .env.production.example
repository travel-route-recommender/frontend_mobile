# Copy to .env.production.local for a release build. Never commit real keys.
EXPO_PUBLIC_DATA_SOURCE=api
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
EXPO_PUBLIC_ANDROID_API_BASE_URL=
EXPO_PUBLIC_IOS_API_BASE_URL=
EXPO_PUBLIC_WEB_API_BASE_URL=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=replace-with-kakao-native-app-key
EXPO_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=replace-with-kakao-javascript-key
EXPO_PUBLIC_KAKAO_MAP_BASE_URL=https://app.example.com
# 기본값: https://api.example.com/api/v1/invites
DURI_INVITE_LINK_BASE_URL=https://api.example.com/api/v1/invites
DURI_ANDROID_PACKAGE=com.example.duri
DURI_IOS_BUNDLE_IDENTIFIER=com.example.duri
DURI_ANDROID_VERSION_CODE=1
DURI_IOS_BUILD_NUMBER=1
