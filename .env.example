EXPO_PUBLIC_DATA_SOURCE=mock
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_DURI_ENGINE=local
# Kakao Developers > Native app key. Used by the Kakao native SDK; no Redirect URI needed.
# Register the iOS bundle ID / Android package name under App Settings > Platform instead.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=
EXPO_PUBLIC_KAKAO_MAP_BASE_URL=http://localhost:3000
