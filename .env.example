EXPO_PUBLIC_DATA_SOURCE=api
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_ANDROID_API_BASE_URL=http://10.0.2.2:3000/api/v1
# Optional physical-device overrides: http://<YOUR_PC_LAN_IP>:3000/api/v1
EXPO_PUBLIC_IOS_API_BASE_URL=
EXPO_PUBLIC_WEB_API_BASE_URL=
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=
EXPO_PUBLIC_KAKAO_MAP_BASE_URL=https://localhost:3000
# 운영 HTTPS 초대 주소를 API와 다른 도메인에서 제공할 때만 설정합니다.
# 비우면 EXPO_PUBLIC_API_BASE_URL 뒤에 /invites를 붙여 사용합니다.
DURI_INVITE_LINK_BASE_URL=
# 개발 중 두리 계산 상세를 확인할 때만 true. 출시 빌드에서는 항상 숨겨집니다.
EXPO_PUBLIC_SHOW_DURI_DIAGNOSTICS=false
