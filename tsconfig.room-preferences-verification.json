{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "customConditions": [],
    "target": "ES2022",
    "rootDir": ".",
    "outDir": ".room-preferences-verification",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "expo-env.d.ts",
    "scripts/verify-room-preferences.ts",
    "src/config/environment.ts",
    "src/domain/**/*.ts",
    "src/duri/duri-analysis/**/*.ts",
    "src/duri/group-preferences/**/*.ts",
    "src/features/auth/services/authTokenState.ts",
    "src/features/duri/services/roomPreferenceApi.ts",
    "src/services/apiClient.ts"
  ]
}
