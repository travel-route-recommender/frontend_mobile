{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "customConditions": [],
    "types": ["node"],
    "target": "ES2022",
    "rootDir": ".",
    "outDir": ".state-integrity-verification",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "scripts/validate-state.ts",
    "scripts/verify-state-integrity.ts",
    "src/core/state-integrity/**/*.ts",
    "src/data/mock/demoData.ts",
    "src/domain/**/*.ts",
    "src/duri/**/*.ts",
    "src/features/auth/types/**/*.ts",
    "src/features/duri/constants.ts",
    "src/features/duri/types.ts",
    "src/features/duri/logic/**/*.ts",
    "src/features/duri/selectors/**/*.ts",
    "src/features/preferences/types.ts",
    "src/features/trip-creation/types.ts",
    "src/store/normalizePersistedState.ts",
    "src/utils/**/*.ts",
    "src/data/workspaceSchedule.ts"
  ]
}
