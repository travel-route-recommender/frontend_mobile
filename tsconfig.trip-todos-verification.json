  "compilerOptions": {
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "customConditions": [],
    "target": "ES2022",
    "rootDir": ".",
    "outDir": ".trip-todos-verification",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
