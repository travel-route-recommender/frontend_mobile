{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "customConditions": [],
    "target": "ES2022",
    "rootDir": ".",
    "outDir": ".trip-flow-verification",
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "scripts/verify-trip-flow.ts",
    "src/domain/**/*.ts",
    "src/duri/**/*.ts",
    "src/features/auth/config.ts",
    "src/features/invitations/types.ts",
    "src/features/invitations/logic/**/*.ts",
    "src/features/trips/logic/**/*.ts",
    "src/features/trips/selectors/**/*.ts",
    "src/features/trips/utils/**/*.ts",
    "src/features/trip-creation/types.ts",
    "src/features/trip-creation/logic/**/*.ts",
    "src/features/trip-creation/mappers/**/*.ts",
    "src/features/trip-creation/services/createTripRoomService.ts",
    "src/features/trip-creation/services/regionService.ts",
    "src/features/trip-creation/validation/**/*.ts",
    "src/store/selectors.ts",
    "src/utils/**/*.ts"
  ]
}
